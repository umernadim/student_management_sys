  "courses": [
    {
      "id": "1",
      "courseName": "Data Structures & Algorithms",
      "code": "CS201",
      "credits": 4,
      "instructor": "Dr. Alan Turing",
      "department": "Computer Science",
      "description": "Fundamental data structures including trees, graphs, heaps, and algorithmic design techniques like dynamic programming and greedy algorithms.",
      "syllabus": [
        "Array & Linked Lists",
        "Trees & Graphs",
        "Dynamic Programming",
        "Complexity Analysis"
      ]
    },
    {
      "id": "2",
      "courseName": "Database Management Systems",
      "code": "CS301",
      "credits": 3,
      "instructor": "Prof. Edgar Codd",
      "department": "Information Systems",
      "description": "Relational algebra, SQL, normalization theory, index structures, query optimization, transaction management, and ACID properties.",
      "syllabus": [
        "Relational Model & SQL",
        "Normalization & Normal Forms",
        "Indexing & Transactions",
        "NoSQL Foundations"
      ]
    },
    {
      "id": "3",
      "courseName": "Modern Web Architecture",
      "code": "CS350",
      "credits": 4,
      "instructor": "Sarah Drasner",
      "department": "Software Engineering",
      "description": "Deep dive into SPA architectures, React ecosystems, SSR/SSG, REST and GraphQL APIs, caching strategies, and web security.",
      "syllabus": [
        "Component Architecture & State",
        "Client-Side Routing & Bundling",
        "REST/GraphQL Integrations",
        "Security & Web Performance"
      ]
    },
    {
      "id": "4",
      "courseName": "Operating Systems & Networking",
      "code": "CS204",
      "credits": 4,
      "instructor": "Dr. Linus Torvalds",
      "department": "Computer Systems",
      "description": "Processes, threads, concurrency, memory management, virtual memory, file systems, socket programming, and network protocols.",
      "syllabus": [
        "Concurrency & Synchronization",
        "Virtual Memory Management",
        "File Systems & I/O",
        "TCP/IP & Network Layers"
      ]
    },
    {
      "id": "5",
      "courseName": "Artificial Intelligence & ML",
      "code": "CS410",
      "credits": 3,
      "instructor": "Dr. Fei-Fei Li",
      "department": "Data Science",
      "description": "Supervised and unsupervised learning, regression, classification, neural networks, decision trees, and model evaluation metrics.",
      "syllabus": [
        "Linear & Logistic Regression",
        "Support Vector Machines",
        "Neural Networks & Backprop",
        "Unsupervised Clustering"
      ]
    },
    {
      "id": "6",
      "courseName": "Cloud Computing & DevOps",
      "code": "CS420",
      "credits": 3,
      "instructor": "Martin Fowler",
      "department": "Software Engineering",
      "description": "Containerization with Docker, Kubernetes orchestration, CI/CD pipelines, cloud infrastructure patterns, and monitoring.",
      "syllabus": [
        "Microservices & Containers",
        "Kubernetes Deployments",
        "CI/CD Automation",
        "Cloud Security & Observability"
      ]
    }
  ],
